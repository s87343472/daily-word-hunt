---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import JsonLd from "@/components/JsonLd.astro";
import WordSearchGame from "@/components/game/WordSearchGame.astro";
import { breadcrumbSchema } from "@/lib/seo/schemas";
import { getAllPacks, getPack, listPackDates } from "@/lib/puzzle/packs";
import { formatDateInTimeZone } from "@/lib/puzzle/daily";
import config from "@/config";

export function getStaticPaths() {
  return getAllPacks().map(p => ({ params: { slug: p.id } }));
}

const locale = Astro.currentLocale ?? config.site.lang;
const slug = Astro.params.slug ?? "";
const pack = getPack(slug);

if (!pack) {
  return Astro.redirect(getRelativeLocaleUrl(locale, "packs"), 302);
}

const tz = config.site.timezone;
const today = formatDateInTimeZone(new Date(), tz);
const allDates = listPackDates(pack.id);
const released = allDates.filter(d => d < today || d === today).sort().reverse();
const hasToday = released.includes(today);
const largePrint = Astro.url.searchParams.get("a11y") === "1";

const title = `${pack.title} Word Search | ${config.site.title}`;
const description = pack.description;

const byMonth = new Map<string, string[]>();
for (const d of released) {
  const key = d.slice(0, 7);
  const list = byMonth.get(key) ?? [];
  list.push(d);
  byMonth.set(key, list);
}
---

<Layout {title} {description}>
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: "Home", path: "" },
      { name: "Series", path: "packs/" },
      { name: pack.shortTitle ?? pack.title, path: `packs/${pack.id}/` },
    ])}
  />
  <Header />
  <main id="main-content" class="pack-hub">
    <header class="pack-hub-bar">
      <div>
        <h1 class="pack-hub-title">{pack.shortTitle ?? pack.title}</h1>
        <p class="pack-hub-sub">{pack.description}</p>
      </div>
      <a class="pack-hub-back" href={getRelativeLocaleUrl(locale, "packs")}
        >All series</a
      >
    </header>

    {
      hasToday ? (
        <section class="pack-hub-play" aria-label="Today’s puzzle">
          <WordSearchGame
            daily
            packId={pack.id}
            timezone={tz}
            fallbackUrl="/puzzles/sample.json"
            largePrint={largePrint}
            printHref={getRelativeLocaleUrl(locale, "print")}
            a11yHref={getRelativeLocaleUrl(
              locale,
              largePrint ? `packs/${pack.id}` : `packs/${pack.id}?a11y=1`
            )}
            compact
          />
        </section>
      ) : (
        <p class="pack-hub-empty">
          No puzzle for today yet. Open a past day below.
        </p>
      )
    }

    <details class="pack-hub-archive">
      <summary>Past days ({released.length})</summary>
      {
        released.length === 0 ? (
          <p class="pack-hub-empty">No released puzzles yet.</p>
        ) : (
          <div class="pack-months">
            {[...byMonth.entries()].map(([month, days]) => (
              <div>
                <h2 class="pack-month">{month}</h2>
                <ul class="pack-days">
                  {days.map(d => (
                    <li>
                      <a
                        href={getRelativeLocaleUrl(
                          locale,
                          `packs/${pack.id}/${d}`
                        )}
                        class:list={["pack-day", { "pack-day--today": d === today }]}
                      >
                        {d === today ? `Today · ${d}` : d}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }
    </details>
  </main>
  <Footer />
</Layout>

<style>
  .pack-hub {
    width: 100%;
    max-width: 28rem;
    margin-inline: auto;
    padding: 0.35rem 0.75rem 2rem;
  }
  .pack-hub-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }
  .pack-hub-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--foreground);
  }
  .pack-hub-sub {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--muted-foreground);
    max-width: 18rem;
  }
  .pack-hub-back {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .pack-hub-back:hover {
    color: var(--accent);
  }
  .pack-hub-empty {
    margin: 0.5rem 0;
    font-size: 0.85rem;
    color: var(--muted-foreground);
  }
  .pack-hub-archive {
    margin-top: 1.25rem;
  }
  .pack-hub-archive > summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted-foreground);
    text-align: center;
    padding: 0.35rem;
  }
  .pack-hub-archive > summary::-webkit-details-marker {
    display: none;
  }
  .pack-hub-archive[open] > summary {
    margin-bottom: 0.65rem;
    color: var(--foreground);
  }
  .pack-months {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .pack-month {
    margin: 0 0 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .pack-days {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .pack-day {
    display: inline-block;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.28rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--foreground);
    background: var(--muted);
  }
  .pack-day:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pack-day--today {
    background: var(--accent);
    border-color: transparent;
    color: var(--accent-foreground);
  }
</style>
