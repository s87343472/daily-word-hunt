---
/**
 * Series directory — dense, scannable, play-first.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import JsonLd from "@/components/JsonLd.astro";
import { breadcrumbSchema } from "@/lib/seo/schemas";
import { getAllPacks, listPackDates } from "@/lib/puzzle/packs";
import { formatDateInTimeZone } from "@/lib/puzzle/daily";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const tz = config.site.timezone;
const today = formatDateInTimeZone(new Date(), tz);
const packs = getAllPacks();

const packCards = packs.map(pack => {
  const dates = listPackDates(pack.id).filter(d => d < today || d === today);
  const hasToday = dates.includes(today);
  const href = getRelativeLocaleUrl(locale, `packs/${pack.id}`);
  const playHref = hasToday
    ? getRelativeLocaleUrl(locale, `packs/${pack.id}/${today}`)
    : href;
  return {
    pack,
    hasToday,
    href,
    playHref,
    dayLabel: dates.length === 1 ? "1 day" : `${dates.length} days`,
  };
});

const title = `Word Search Series & Themes | ${config.site.title}`;
const description =
  "Browse daily word search series by theme — daily, nature, cities, history. Free browser play.";
---

<Layout {title} {description}>
  <JsonLd
    slot="head"
    data={breadcrumbSchema([
      { name: "Home", path: "" },
      { name: "Series", path: "packs/" },
    ])}
  />
  <Header />
  <main id="main-content" class="packs-page">
    <header class="packs-head">
      <h1 class="packs-h1">Series</h1>
      <p class="packs-lead">
        Themed calendars. Home is always the main Daily pack.
      </p>
    </header>

    <ul class="pack-list">
      {
        packCards.map(({ pack, hasToday, href, playHref, dayLabel }) => (
          <li class="pack-row">
            <div class="pack-main">
              <a class="pack-name" href={href}>
                {pack.shortTitle ?? pack.title}
              </a>
              <p class="pack-desc">{pack.description}</p>
              <p class="pack-meta">
                {dayLabel}
                {hasToday ? " · today" : ""}
              </p>
            </div>
            <a
              class:list={["pack-cta", { "pack-cta--primary": hasToday }]}
              href={playHref}
            >
              {hasToday ? "Play" : "Open"}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</Layout>

<style>
  .packs-page {
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
    padding: 0.5rem 0.75rem 2rem;
  }
  .packs-head {
    margin-bottom: 0.85rem;
  }
  .packs-h1 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }
  .packs-lead {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .pack-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pack-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: var(--muted);
  }
  .pack-main {
    flex: 1;
    min-width: 0;
  }
  .pack-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--foreground);
    text-decoration: none;
  }
  .pack-name:hover {
    color: var(--accent);
  }
  .pack-desc {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--muted-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pack-meta {
    margin: 0.25rem 0 0;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted-foreground);
  }
  .pack-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.5rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }
  .pack-cta--primary {
    background: var(--accent);
    border-color: transparent;
    color: var(--accent-foreground);
  }
  .pack-cta:hover {
    filter: brightness(1.05);
  }
  @media (min-width: 640px) {
    .packs-page {
      padding-inline: 1rem;
    }
  }
</style>
