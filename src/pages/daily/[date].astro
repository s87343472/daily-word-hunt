---
/**
 * Optional archive / share URL for a dated puzzle.
 * Primary play is still `/` — users never need to type this for daily use.
 * We do not advertise future dates in nav; files may exist early for CDN.
 */
import fs from "node:fs";
import path from "node:path";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WordSearchGame from "@/components/game/WordSearchGame.astro";
import { isValidPuzzleDate } from "@/lib/puzzle/daily";
import config from "@/config";

export function getStaticPaths() {
  const dir = path.join(process.cwd(), "public/puzzles");
  if (!fs.existsSync(dir)) return [];
  return fs
    .readdirSync(dir)
    .filter(f => /^\d{4}-\d{2}-\d{2}\.json$/.test(f))
    .map(f => ({
      params: { date: f.replace(/\.json$/, "") },
    }));
}

const locale = Astro.currentLocale ?? config.site.lang;
const date = Astro.params.date ?? "";

if (!isValidPuzzleDate(date)) {
  return Astro.redirect(getRelativeLocaleUrl(locale, ""), 302);
}

const largePrint = Astro.url.searchParams.get("a11y") === "1";
const puzzleUrl = `/puzzles/${date}.json`;
---

<Layout
  title={`${config.site.title} · ${date}`}
  description={`Word search puzzle for ${date}. Free browser play.`}
>
  <Header />
  <main id="main-content" class="play-main">
    <p class="archive-banner">
      Puzzle for <time datetime={date}>{date}</time>
      ·
      <a href={getRelativeLocaleUrl(locale, "")}>Play today</a>
      ·
      <a href={getRelativeLocaleUrl(locale, "past")}>All past</a>
    </p>
    <WordSearchGame
      puzzleUrl={puzzleUrl}
      largePrint={largePrint}
      printHref={getRelativeLocaleUrl(locale, "print")}
      a11yHref={getRelativeLocaleUrl(
        locale,
        largePrint ? `daily/${date}` : `daily/${date}?a11y=1`
      )}
      a11yLabel={largePrint ? "Default size" : "Large print page"}
    />
  </main>
  <Footer />
</Layout>

<style is:global>
  .play-main {
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
    padding-inline: 0.75rem;
    padding-top: 0.35rem;
    padding-bottom: 1.5rem;
  }
  .archive-banner {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    color: var(--muted-foreground, #afb9ca);
  }
  .archive-banner a {
    color: var(--accent, #ff6b01);
    font-weight: 600;
    text-decoration: none;
  }
  .archive-banner a:hover {
    text-decoration: underline;
  }
  body:has(.play-main) header.app-layout > div {
    padding-top: 0.55rem !important;
    padding-bottom: 0.55rem !important;
  }
</style>
