---
/**
 * Product home = today's puzzle + GEO/SEO landing for "daily word search".
 * Board stays first; citable server-rendered copy sits below the fold.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import JsonLd from "@/components/JsonLd.astro";
import WordSearchGame from "@/components/game/WordSearchGame.astro";
import { homeJsonLdGraph } from "@/lib/seo/schemas";
import { formatDateInTimeZone } from "@/lib/puzzle/daily";
import { getAllPacks, listPackDates } from "@/lib/puzzle/packs";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const largePrint = Astro.url.searchParams.get("a11y") === "1";
const homePath = getRelativeLocaleUrl(locale, "");
const homeHref = homePath.endsWith("/") ? homePath : `${homePath}/`;
const a11yHref = largePrint ? homeHref : `${homeHref}?a11y=1`;
const tz = config.site.timezone;
const today = formatDateInTimeZone(new Date(), tz);

const packs = getAllPacks();
const packCount = packs.length;
const releasedDaily = listPackDates("daily").filter(
  d => d < today || d === today
).length;

const title = `Free Daily Word Search | ${config.site.title}`;
const description = config.site.description;
/** Site launch / first public content signal for freshness schema */
const datePublished = "2026-08-01";
const dateModified = today;

const jsonLd = homeJsonLdGraph({
  title,
  description,
  datePublished,
  dateModified,
});
---

<Layout
  {title}
  {description}
  datePublished={datePublished}
  dateModified={dateModified}
>
  <JsonLd slot="head" data={jsonLd} />
  <Header />
  <main
    id="main-content"
    class="play-main"
    data-layout="index"
    data-home-path={homePath}
  >
    <header class="home-seo-head">
      <h1 class="home-h1">Free daily word search</h1>
      <p class="home-lead">
        Play today’s free browser word search — drag or tap to find every word.
        New puzzle each day. No account required.
      </p>
    </header>

    <WordSearchGame
      daily
      packId="daily"
      timezone={tz}
      fallbackUrl="/puzzles/sample.json"
      largePrint={largePrint}
      printHref={getRelativeLocaleUrl(locale, "print")}
      a11yHref={a11yHref}
      a11yLabel={largePrint ? "Default size" : "Large print page"}
    />

    <!-- GEO / SEO: server-rendered, answer-first, citable (below the fold) -->
    <article class="home-geo" aria-labelledby="home-geo-heading">
      <header class="home-geo-byline">
        <p>
          By <a href={getRelativeLocaleUrl(locale, "about")}
            ><span itemprop="author">{config.site.author}</span></a
          >
          ·
          <time datetime={datePublished}>Published {datePublished}</time>
          ·
          <time datetime={dateModified}>Updated {dateModified}</time>
        </p>
      </header>

      <h2 id="home-geo-heading" class="home-geo-h2">
        What is Daily Word Hunt?
      </h2>
      <p>
        <strong
          >Daily Word Hunt is a free online daily word search game</strong
        > you play in the browser. Letters are already on the grid; you find every
        word from the list by selecting a straight line of letters. There is no
        account, no download, and no paywall for the daily puzzle.
      </p>

      <h2 class="home-geo-h2">What is a word search puzzle?</h2>
      <h3 class="home-geo-h3">Dictionary definition</h3>
      <p>
        A word search (also called a word find or 划词 puzzle) is a game where
        words are hidden in a grid of letters. Merriam-Webster describes “word
        search” in everyday use as a puzzle built from letters arranged so that
        listed words can be located in the grid.
        <cite>
          <a
            href="https://www.merriam-webster.com/dictionary/word%20search"
            rel="noopener noreferrer"
            target="_blank">Merriam-Webster, “word search”</a
          >
        </cite>
      </p>
      <h3 class="home-geo-h3">How word searches usually work</h3>
      <blockquote class="home-quote">
        <p>
          “Word search” puzzles ask players to find words hidden among random
          letters, typically in straight lines that may run in multiple
          directions.
        </p>
        <footer>
          Paraphrase aligned with common dictionary definitions of word-search
          puzzles;
          <cite>
            <a
              href="https://en.wikipedia.org/wiki/Word_search"
              rel="noopener noreferrer"
              target="_blank">Wikipedia: Word search</a
            >
          </cite>
        </footer>
      </blockquote>

      <h2 class="home-geo-h2">How do you play this site?</h2>
      <p>
        <strong
          >Drag from the first letter to the last, or tap the first letter then
          the last.</strong
        > Only straight lines count. Full controls are on the
        <a href={getRelativeLocaleUrl(locale, "how-to")}>How to play</a> page.
      </p>
      <h3 class="home-geo-h3">Drag selection</h3>
      <p>
        Press on the first letter, slide through neighboring cells to the last
        letter, then release. The path must be a straight line.
      </p>
      <h3 class="home-geo-h3">Tap-then-tap selection</h3>
      <p>
        Tap the first letter, then tap the last letter. Useful on phones when
        drag overshoots.
      </p>
      <h3 class="home-geo-h3">Allowed directions</h3>
      <p>
        Horizontal, vertical, diagonal, and reverse are allowed—no bent paths.
      </p>
      <h3 class="home-geo-h3">Typical session steps</h3>
      <ol class="home-steps">
        <li>Open this home page to load today’s default-series puzzle.</li>
        <li>Scan the word list (about 8 words on a typical day).</li>
        <li>Select each word’s path on the ~10×10 letter grid.</li>
        <li>Use a limited Hint if you are stuck on the last words.</li>
      </ol>

      <h2 class="home-geo-h2">Is Daily Word Hunt free?</h2>
      <p>
        <strong>Yes. Daily play costs USD $0</strong> and does not require an
        account. Optional future features (such as a leaderboard) will not block
        the free daily puzzle.
      </p>

      <h2 class="home-geo-h2">Key facts (at a glance)</h2>
      <h3 class="home-geo-h3">Pricing, account, and today’s date</h3>
      <table class="home-facts">
        <tbody>
          <tr>
            <th scope="row">Price</th>
            <td>Free (USD $0) for daily play</td>
          </tr>
          <tr>
            <th scope="row">Account</th>
            <td>Not required</td>
          </tr>
          <tr>
            <th scope="row">Today’s date (site TZ)</th>
            <td><time datetime={today}>{today}</time> ({tz})</td>
          </tr>
        </tbody>
      </table>
      <h3 class="home-geo-h3">Series, archive, and accessibility</h3>
      <table class="home-facts">
        <tbody>
          <tr>
            <th scope="row">Themed series</th>
            <td>
              {packCount} active packs (e.g. daily, nature, cities) —
              <a href={getRelativeLocaleUrl(locale, "packs")}>browse series</a>
            </td>
          </tr>
          <tr>
            <th scope="row">Default series archive</th>
            <td>
              {releasedDaily}+ released days on
              <a href={getRelativeLocaleUrl(locale, "past")}>Past puzzles</a>
            </td>
          </tr>
          <tr>
            <th scope="row">Typical puzzle size</th>
            <td>~10×10 grid, ~8 hidden words per day</td>
          </tr>
          <tr>
            <th scope="row">Print / large print</th>
            <td>
              <a href={getRelativeLocaleUrl(locale, "print")}>Print today</a> ·
              large-print toggle on the board
            </td>
          </tr>
        </tbody>
      </table>

      <h2 class="home-geo-h2">How is this different from Wordscapes-style games?</h2>
      <h3 class="home-geo-h3">Find-the-word vs fill-in</h3>
      <p>
        <strong
          >This is find-the-word (划词), not rack-based fill-in.</strong
        > Wordscapes-style games ask you to build words from a set of letters into
        empty slots. Daily Word Hunt hides complete words inside a filled grid; you
        only locate and select them.
      </p>
      <h3 class="home-geo-h3">Content and IP approach</h3>
      <p>
        We avoid unlicensed movie/game franchise packs as product IP—word lists
        are general vocabulary or original themes you can browse under
        <a href={getRelativeLocaleUrl(locale, "packs")}>Series</a>.
      </p>

      <h2 class="home-geo-h2">Where else can I go?</h2>
      <h3 class="home-geo-h3">Help and series</h3>
      <ul class="home-links">
        <li>
          <a href={getRelativeLocaleUrl(locale, "faq")}>FAQ</a> — short answers
          on privacy, printing, and daily release
        </li>
        <li>
          <a href={getRelativeLocaleUrl(locale, "packs")}>Series & themes</a> —
          nature, cities, and more calendars
        </li>
        <li>
          <a href={getRelativeLocaleUrl(locale, "posts")}>Tips</a> — scanning
          habits and print guidance
        </li>
      </ul>
      <h3 class="home-geo-h3">About and legal</h3>
      <ul class="home-links">
        <li>
          <a href={getRelativeLocaleUrl(locale, "about")}>About</a> ·
          <a href={getRelativeLocaleUrl(locale, "privacy")}>Privacy</a> ·
          <a href={getRelativeLocaleUrl(locale, "terms")}>Terms</a> ·
          <a href={getRelativeLocaleUrl(locale, "contact")}>Contact</a>
        </li>
      </ul>

      <p class="home-geo-note">
        Prefer machines? See
        <a href="/llms.txt">llms.txt</a> for a short plain-text site summary for
        AI tools, and the
        <a href="/sitemap-index.xml">XML sitemap</a> for page discovery.
      </p>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .play-main {
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
    padding-inline: 0.75rem;
    padding-top: 0.35rem;
    padding-bottom: 1.5rem;
  }
  body:has(.play-main) header.app-layout > div {
    padding-top: 0.55rem !important;
    padding-bottom: 0.55rem !important;
  }
  .home-seo-head {
    margin-bottom: 0.45rem;
  }
  .home-h1 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--foreground, #eaedf3);
  }
  .home-lead {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--muted-foreground, #afb9ca);
  }

  .home-geo {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid
      color-mix(in oklab, var(--border, #3a4560) 70%, transparent);
    max-width: 36rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--muted-foreground, #afb9ca);
  }
  .home-geo-byline {
    margin: 0 0 1rem;
    font-size: 0.78rem;
    color: var(--muted-foreground, #afb9ca);
  }
  .home-geo-byline a {
    color: var(--accent, #ff6b01);
    font-weight: 600;
    text-decoration: none;
  }
  .home-geo-h2 {
    margin: 1.25rem 0 0.4rem;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--foreground, #eaedf3);
  }
  .home-geo-h3 {
    margin: 0.85rem 0 0.3rem;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--foreground, #eaedf3);
  }
  .home-geo p {
    margin: 0 0 0.65rem;
  }
  .home-geo strong {
    color: var(--foreground, #eaedf3);
    font-weight: 600;
  }
  .home-geo a {
    color: var(--accent, #ff6b01);
    font-weight: 600;
    text-decoration: none;
  }
  .home-geo a:hover {
    text-decoration: underline;
  }
  .home-quote {
    margin: 0.75rem 0 1rem;
    padding: 0.65rem 0.85rem;
    border-inline-start: 3px solid var(--accent, #ff6b01);
    background: color-mix(in oklab, var(--muted, #343f60) 40%, transparent);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .home-quote p {
    margin: 0 0 0.4rem;
    font-style: italic;
  }
  .home-quote footer {
    font-size: 0.78rem;
    font-style: normal;
  }
  .home-steps {
    margin: 0.35rem 0 0.85rem;
    padding-left: 1.2rem;
  }
  .home-steps li {
    margin-bottom: 0.3rem;
  }
  .home-facts {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    margin: 0.35rem 0 0.85rem;
  }
  .home-facts th,
  .home-facts td {
    border: 1px solid color-mix(in oklab, var(--border, #3a4560) 70%, transparent);
    padding: 0.4rem 0.55rem;
    text-align: start;
    vertical-align: top;
  }
  .home-facts th {
    width: 38%;
    font-weight: 700;
    color: var(--foreground, #eaedf3);
    background: color-mix(in oklab, var(--muted, #343f60) 35%, transparent);
  }
  .home-links {
    margin: 0.35rem 0 0.85rem;
    padding-left: 1.2rem;
  }
  .home-links li {
    margin-bottom: 0.35rem;
  }
  .home-geo-note {
    font-size: 0.8rem;
    margin-top: 1rem !important;
  }

  @media (min-width: 640px) {
    .play-main {
      padding-inline: 1rem;
      padding-top: 0.75rem;
      max-width: 36rem;
    }
    body:has(.play-main) header.app-layout > div {
      padding-top: 1rem !important;
      padding-bottom: 1rem !important;
    }
    .home-h1 {
      font-size: 1.15rem;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const el = document.querySelector("#main-content") as HTMLElement | null;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (el?.dataset.layout) {
      sessionStorage.setItem("backUrl", el.dataset.homePath ?? baseRoot);
    }
  });
</script>
