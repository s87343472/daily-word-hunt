---
/**
 * Home: play-first. Minimal chrome above the board; GEO/SEO in a collapsed
 * details block so casual players are not hit with essay density.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import JsonLd from "@/components/JsonLd.astro";
import WordSearchGame from "@/components/game/WordSearchGame.astro";
import { homeJsonLdGraph } from "@/lib/seo/schemas";
import { formatDateInTimeZone } from "@/lib/puzzle/daily";
import { getAllPacks, listPackDates } from "@/lib/puzzle/packs";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const largePrint = Astro.url.searchParams.get("a11y") === "1";
const homePath = getRelativeLocaleUrl(locale, "");
const homeHref = homePath.endsWith("/") ? homePath : `${homePath}/`;
const a11yHref = largePrint ? homeHref : `${homeHref}?a11y=1`;
const tz = config.site.timezone;
const today = formatDateInTimeZone(new Date(), tz);

const packs = getAllPacks();
const packCount = packs.length;
const releasedDaily = listPackDates("daily").filter(
  d => d < today || d === today
).length;

const title = `Free Daily Word Search | ${config.site.title}`;
const description = config.site.description;
const datePublished = "2026-08-01";
const dateModified = today;

const jsonLd = homeJsonLdGraph({
  title,
  description,
  datePublished,
  dateModified,
});

const howTo = getRelativeLocaleUrl(locale, "how-to");
const packsUrl = getRelativeLocaleUrl(locale, "packs");
const pastUrl = getRelativeLocaleUrl(locale, "past");
const printUrl = getRelativeLocaleUrl(locale, "print");
const faqUrl = getRelativeLocaleUrl(locale, "faq");
const aboutUrl = getRelativeLocaleUrl(locale, "about");
const postsUrl = getRelativeLocaleUrl(locale, "posts");
const privacyUrl = getRelativeLocaleUrl(locale, "privacy");
const termsUrl = getRelativeLocaleUrl(locale, "terms");
const contactUrl = getRelativeLocaleUrl(locale, "contact");
---

<Layout
  {title}
  {description}
  datePublished={datePublished}
  dateModified={dateModified}
>
  <JsonLd slot="head" data={jsonLd} />
  <Header />

  <main
    id="main-content"
    class="home"
    data-layout="index"
    data-home-path={homePath}
  >
    <!-- SEO H1: not competing with the board visually -->
    <h1 class="sr-only">Free daily word search</h1>

    <section class="home-play" aria-label="Today’s puzzle">
      <WordSearchGame
        daily
        packId="daily"
        timezone={tz}
        fallbackUrl="/puzzles/sample.json"
        largePrint={largePrint}
        printHref={printUrl}
        a11yHref={a11yHref}
        compact
      />
    </section>

    <!-- GEO/SEO: collapsed by default so play stays the job -->
    <details class="home-about">
      <summary class="home-about-summary">About this free word search</summary>
      <article class="home-read" aria-labelledby="home-read-title">
        <header class="home-read-head">
          <h2 id="home-read-title" class="home-read-title">
            About this free word search
          </h2>
          <p class="home-byline">
            By
            <a href={aboutUrl}>{config.site.author}</a>
            ·
            <time datetime={datePublished}>Published {datePublished}</time>
            ·
            <time datetime={dateModified}>Updated {dateModified}</time>
          </p>
        </header>

        <section class="home-block" aria-labelledby="q-what">
          <h3 id="q-what" class="home-h3">What is Daily Word Hunt?</h3>
          <p>
            <strong
              >Daily Word Hunt is a free online daily word search game</strong
            > in the browser. Letters are already on the grid; you find every word
            from the list by selecting a straight line. No account, no download, no
            paywall for the daily puzzle.
          </p>
        </section>

        <section class="home-block" aria-labelledby="q-def">
          <h3 id="q-def" class="home-h3">What is a word search puzzle?</h3>
          <p>
            A word search (word find / 划词) hides listed words inside a grid of
            letters. Merriam-Webster treats “word search” as a puzzle where words
            are arranged among letters so players can locate them.
            <cite>
              <a
                href="https://www.merriam-webster.com/dictionary/word%20search"
                rel="noopener noreferrer"
                target="_blank">Merriam-Webster</a
              >
            </cite>
          </p>
          <blockquote class="home-quote">
            <p>
              Word search puzzles ask players to find words hidden among
              letters, usually in straight lines that can run in several
              directions.
            </p>
            <footer>
              Common definition;
              <cite>
                <a
                  href="https://en.wikipedia.org/wiki/Word_search"
                  rel="noopener noreferrer"
                  target="_blank">Wikipedia: Word search</a
                >
              </cite>
            </footer>
          </blockquote>
        </section>

        <section class="home-block" aria-labelledby="q-how">
          <h3 id="q-how" class="home-h3">How do you play on this site?</h3>
          <p>
            <strong>Drag first letter to last, or tap first then last.</strong>
            Only straight lines count: horizontal, vertical, diagonal, and reverse.
            Details:
            <a href={howTo}>How to play</a>.
          </p>
          <ol class="home-steps">
            <li>Load today’s puzzle on this page.</li>
            <li>Scan the list (about 8 words on a typical day).</li>
            <li>Select each path on the ~10×10 grid.</li>
            <li>Use a limited Hint for the last hard words.</li>
          </ol>
        </section>

        <section class="home-block" aria-labelledby="q-free">
          <h3 id="q-free" class="home-h3">Is Daily Word Hunt free?</h3>
          <p>
            <strong>Yes. Daily play is USD $0</strong> and does not require an
            account.
          </p>
        </section>

        <section class="home-block" aria-labelledby="q-facts">
          <h3 id="q-facts" class="home-h3">Key facts</h3>
          <dl class="home-facts">
            <div>
              <dt>Price</dt>
              <dd>Free (USD $0)</dd>
            </div>
            <div>
              <dt>Account</dt>
              <dd>Not required</dd>
            </div>
            <div>
              <dt>Today (site TZ)</dt>
              <dd>
                <time datetime={today}>{today}</time>
                <span class="home-muted"> · {tz}</span>
              </dd>
            </div>
            <div>
              <dt>Series</dt>
              <dd>
                {packCount} packs ·
                <a href={packsUrl}>browse</a>
              </dd>
            </div>
            <div>
              <dt>Archive</dt>
              <dd>
                {releasedDaily}+ days ·
                <a href={pastUrl}>past puzzles</a>
              </dd>
            </div>
            <div>
              <dt>Typical size</dt>
              <dd>~10×10 grid, ~8 words</dd>
            </div>
            <div>
              <dt>Print</dt>
              <dd><a href={printUrl}>Print today</a></dd>
            </div>
          </dl>
        </section>

        <section class="home-block" aria-labelledby="q-diff">
          <h3 id="q-diff" class="home-h3">
            How is this different from Wordscapes-style games?
          </h3>
          <p>
            <strong>This is find-the-word (划词), not rack fill-in.</strong>
            Fill games build words from letter racks into empty slots. Here words
            are already in the grid; you only find and select them.
          </p>
        </section>

        <section class="home-block" aria-labelledby="q-more">
          <h3 id="q-more" class="home-h3">More pages</h3>
          <ul class="home-more">
            <li><a href={faqUrl}>FAQ</a></li>
            <li><a href={packsUrl}>Series</a></li>
            <li><a href={postsUrl}>Tips</a></li>
            <li><a href={aboutUrl}>About</a></li>
            <li><a href={privacyUrl}>Privacy</a></li>
            <li><a href={termsUrl}>Terms</a></li>
            <li><a href={contactUrl}>Contact</a></li>
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
        </section>
      </article>
    </details>
  </main>

  <Footer />
</Layout>

<style is:global>
  .home {
    --home-pad: 0.75rem;
    --home-max: 28rem;
    width: 100%;
    max-width: var(--home-max);
    margin-inline: auto;
    padding-inline: var(--home-pad);
    padding-top: 0.25rem;
    padding-bottom: 2rem;
  }
  body:has(.home) header.app-layout > div {
    padding-top: 0.5rem !important;
    padding-bottom: 0.5rem !important;
  }

  .home-play {
    width: 100%;
  }

  /* About: one quiet line until opened */
  .home-about {
    margin-top: 1.75rem;
    max-width: 40rem;
    margin-inline: auto;
  }
  .home-about-summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted-foreground);
    text-align: center;
    padding: 0.35rem 0.5rem;
  }
  .home-about-summary::-webkit-details-marker {
    display: none;
  }
  .home-about-summary::before {
    content: "▸ ";
    color: var(--accent);
  }
  .home-about[open] .home-about-summary::before {
    content: "▾ ";
  }
  .home-about[open] .home-about-summary {
    margin-bottom: 0.75rem;
    color: var(--foreground);
  }

  .home-read {
    padding: 1.1rem 1rem 1.35rem;
    border-radius: 0.85rem;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    font-size: 1rem;
    line-height: 1.65;
  }
  .home-read-head {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .home-read-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--foreground);
  }
  .home-byline {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }
  .home-byline a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .home-block {
    margin: 0 0 1.2rem;
  }
  .home-block:last-child {
    margin-bottom: 0;
  }
  .home-h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--foreground);
  }
  .home-block p {
    margin: 0 0 0.55rem;
    color: var(--foreground);
  }
  .home-block a {
    color: var(--accent);
    font-weight: 600;
    text-underline-offset: 2px;
  }
  .home-muted {
    color: var(--muted-foreground);
  }
  .home-quote {
    margin: 0.5rem 0 0;
    padding: 0.65rem 0.8rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--muted);
  }
  .home-quote p {
    margin: 0 0 0.35rem;
    font-style: italic;
  }
  .home-quote footer {
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }
  .home-steps {
    margin: 0.4rem 0 0;
    padding-left: 1.2rem;
  }
  .home-facts {
    margin: 0.25rem 0 0;
    display: grid;
    gap: 0.35rem;
  }
  .home-facts > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.5rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .home-facts dt {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted-foreground);
  }
  .home-facts dd {
    margin: 0;
    font-size: 0.9375rem;
  }
  .home-more {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
  }

  @media (min-width: 640px) {
    .home {
      --home-pad: 1rem;
      padding-top: 0.35rem;
    }
    body:has(.home) header.app-layout > div {
      padding-top: 0.65rem !important;
      padding-bottom: 0.65rem !important;
    }
    .home-read {
      padding: 1.35rem 1.25rem 1.5rem;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const el = document.querySelector("#main-content") as HTMLElement | null;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (el?.dataset.layout) {
      sessionStorage.setItem("backUrl", el.dataset.homePath ?? baseRoot);
    }
  });
</script>
