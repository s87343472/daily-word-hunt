---
/**
 * Print pack studio: randomly generate a batch of worksheets → multi-page A4 print.
 * Not the interactive player; not “today only”.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PrintPack from "@/components/game/PrintPack.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const title = `Printable Word Search Pack | ${config.site.title}`;
const description =
  "Generate a free batch of random word search worksheets and print them on A4 — 4 to 12 pages, 10×10 or larger grids. No account required.";
---

<Layout {title} {description}>
  <div class="no-print">
    <Header />
  </div>
  <main class="pp-page">
    <p class="pp-play-link no-print">
      Prefer today’s interactive puzzle?
      <a href={getRelativeLocaleUrl(locale, "")}>Play today</a>
      ·
      <a href={getRelativeLocaleUrl(locale, "how-to")}>How to play</a>
    </p>
    <PrintPack />
  </main>
  <div class="no-print">
    <Footer />
  </div>
</Layout>

<style>
  .pp-page {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
    padding: 1rem 1rem 2.5rem;
  }

  .pp-play-link {
    margin: 0 0 0.85rem;
    font-size: 0.85rem;
    color: var(--muted-foreground);
  }

  .pp-play-link a {
    color: var(--accent);
    font-weight: 600;
    text-underline-offset: 2px;
  }

  @media print {
    .pp-page {
      max-width: none;
      padding: 0;
      margin: 0;
    }
  }
</style>
