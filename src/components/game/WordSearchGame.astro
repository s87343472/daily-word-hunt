---
/**
 * Word search player — industry-standard interactions:
 * - Drag from first letter to last (8 directions + reverse)
 * - Or tap first letter, then tap last (no drag required)
 * Styles global under .ws so JS-created cells receive CSS.
 */
type Props = {
  puzzleUrl?: string;
  puzzleJson?: string;
  /**
   * Load today's calendar puzzle for a pack:
   * /puzzles/{packId}/YYYY-MM-DD.json in site timezone.
   */
  daily?: boolean;
  /** Pack / series id (default daily). Used with daily=true. */
  packId?: string;
  timezone?: string;
  fallbackUrl?: string;
  largePrint?: boolean;
  printHref?: string;
  a11yHref?: string;
  a11yLabel?: string;
  /**
   * Play-first chrome: progress + timer only; hide title string, de-emphasize
   * footer tools. Use on the home page where users come to play, not read.
   */
  compact?: boolean;
  /** practice | daily — for cloud progress sync */
  playKind?: "daily" | "practice";
  /** Practice bank id 1..100000 when playKind=practice */
  practiceBankId?: number;
};

const {
  puzzleUrl = "/puzzles/sample.json",
  puzzleJson,
  daily = false,
  packId = "daily",
  timezone = "America/New_York",
  fallbackUrl = "/puzzles/sample.json",
  largePrint = false,
  printHref,
  a11yHref,
  a11yLabel = "Large print page",
  compact = false,
  playKind = "daily",
  practiceBankId,
} = Astro.props;
---

<div
  class:list={["ws", { "ws--large": largePrint, "ws--compact": compact }]}
  data-ws-root
  data-puzzle-url={puzzleJson || daily ? undefined : puzzleUrl}
  data-puzzle={puzzleJson}
  data-daily={daily ? "1" : undefined}
  data-pack={daily ? packId : packId}
  data-tz={daily ? timezone : undefined}
  data-fallback={daily ? fallbackUrl : undefined}
  data-compact={compact ? "1" : undefined}
  data-play-kind={playKind}
  data-practice-bank-id={practiceBankId != null ? String(practiceBankId) : undefined}
>
  <!-- HUD: compact = progress/timer only (title for SR). -->
  <header class="ws-hud">
    <h2
      data-ws-title
      class:list={["ws-title", { "sr-only": compact }]}>Loading…</h2
    >
    <div class="ws-hud-right" aria-live="polite">
      <span class="ws-pill"
        ><span data-ws-progress>0/0</span></span
      >
      <span class="ws-pill ws-pill--time"
        ><span data-ws-timer>0:00</span></span
      >
    </div>
  </header>

  <div class="ws-progress-track" aria-hidden="true">
    <div data-ws-progress-bar class="ws-progress-bar"></div>
  </div>

  <!-- Board first — hero -->
  <div class="ws-stage">
    <div
      data-ws-board
      class="ws-board"
      role="grid"
      aria-label="Word search grid"
    >
    </div>
  </div>

  <p data-ws-hint-msg class="ws-hint-msg" aria-live="polite"></p>

  <!-- Chips immediately under board -->
  <section class="ws-words-panel" aria-label="Word list">
    <div class="ws-words-head">
      <h2 class="ws-words-title">Words</h2>
      <button type="button" class="ws-tool-btn" data-ws-hint>Hint (3)</button>
    </div>
    <ul data-ws-wordlist class="ws-chips"></ul>
  </section>

  <div data-ws-gloss class="ws-gloss" hidden>
    <div class="ws-gloss-inner">
      <strong data-ws-gloss-word class="ws-gloss-word"></strong>
      <p data-ws-gloss-text class="ws-gloss-text"></p>
    </div>
  </div>

  <!-- Secondary tools: muted single row (compact hides long a11y link) -->
  <footer class="ws-footer-tools">
    <label class="ws-a11y">
      <input type="checkbox" data-ws-large-toggle checked={largePrint} />
      <span>Large print</span>
    </label>
    {
      printHref && (
        <a class="ws-link" href={printHref}>
          Print
        </a>
      )
    }
    {
      a11yHref && !compact && (
        <a class="ws-link" href={a11yHref}>
          {a11yLabel}
        </a>
      )
    }
  </footer>

  {
    !compact && (
      <details class="ws-help-details">
        <summary>How to play</summary>
        <p>
          <strong>Drag</strong> from the first letter to the last, or
          <strong>tap</strong> the first letter then the last. Straight lines
          only (horizontal, vertical, diagonal, reverse OK).
        </p>
      </details>
    )
  }

  <p data-ws-status class="ws-status" aria-live="polite"></p>

  <div data-ws-win class="ws-win" hidden>
    <div class="ws-win-card">
      <p class="ws-win-emoji" aria-hidden="true">✓</p>
      <h3 class="ws-win-title">Nice work!</h3>
      <p data-ws-win-detail class="ws-win-detail"></p>
      <p data-ws-win-streak class="ws-win-streak" hidden></p>
      <div class="ws-win-actions">
        <button type="button" data-ws-win-share class="ws-win-btn ws-win-btn--ghost">
          Share
        </button>
        <button type="button" data-ws-win-dismiss class="ws-win-btn">
          Keep playing
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    formatShareText,
    markPuzzleComplete,
    readProgress,
  } from "@/scripts/progress";

  type Cell = { r: number; c: number };
  type PuzzleWord = { word: string; gloss: string; path?: Cell[] };
  type Puzzle = {
    id: string;
    title: string;
    description?: string;
    playDate?: string;
    pack?: string;
    rows: number;
    cols: number;
    grid: string[][];
    words: PuzzleWord[];
  };
  type GameCtl = { destroy: () => void };

  const FOUND_COLORS = 8;

  function formatTime(ms: number) {
    const s = Math.floor(ms / 1000);
    const m = Math.floor(s / 60);
    return `${m}:${String(s % 60).padStart(2, "0")}`;
  }

  function lineBetween(a: Cell, b: Cell): Cell[] | null {
    const dr = b.r - a.r;
    const dc = b.c - a.c;
    const steps = Math.max(Math.abs(dr), Math.abs(dc));
    if (steps === 0) return [a];
    const sr = dr === 0 ? 0 : dr / Math.abs(dr);
    const sc = dc === 0 ? 0 : dc / Math.abs(dc);
    if (Math.abs(dr) !== steps && dr !== 0) return null;
    if (Math.abs(dc) !== steps && dc !== 0) return null;
    if (
      Math.abs(dr) !== 0 &&
      Math.abs(dc) !== 0 &&
      Math.abs(dr) !== Math.abs(dc)
    )
      return null;
    const path: Cell[] = [];
    for (let i = 0; i <= steps; i++) {
      path.push({ r: a.r + sr * i, c: a.c + sc * i });
    }
    return path;
  }

  function cellsEqual(a: Cell, b: Cell) {
    return a.r === b.r && a.c === b.c;
  }

  function mountGame(root: HTMLElement): GameCtl {
    const boardEl = root.querySelector<HTMLElement>("[data-ws-board]")!;
    const wordlistEl = root.querySelector<HTMLElement>("[data-ws-wordlist]")!;
    const titleEl = root.querySelector<HTMLElement>("[data-ws-title]")!;
    const progressEl = root.querySelector<HTMLElement>("[data-ws-progress]")!;
    const progressBar = root.querySelector<HTMLElement>(
      "[data-ws-progress-bar]"
    )!;
    const timerEl = root.querySelector<HTMLElement>("[data-ws-timer]")!;
    const statusEl = root.querySelector<HTMLElement>("[data-ws-status]")!;
    const hintMsg = root.querySelector<HTMLElement>("[data-ws-hint-msg]")!;
    const glossBox = root.querySelector<HTMLElement>("[data-ws-gloss]")!;
    const glossWord = root.querySelector<HTMLElement>("[data-ws-gloss-word]")!;
    const glossText = root.querySelector<HTMLElement>("[data-ws-gloss-text]")!;
    const winEl = root.querySelector<HTMLElement>("[data-ws-win]")!;
    const winDetail = root.querySelector<HTMLElement>("[data-ws-win-detail]")!;
    const winStreak = root.querySelector<HTMLElement>("[data-ws-win-streak]");
    const winDismiss = root.querySelector<HTMLElement>(
      "[data-ws-win-dismiss]"
    )!;
    const winShare = root.querySelector<HTMLButtonElement>(
      "[data-ws-win-share]"
    );
    const largeToggle = root.querySelector<HTMLInputElement>(
      "[data-ws-large-toggle]"
    )!;
    const hintBtn = root.querySelector<HTMLButtonElement>("[data-ws-hint]")!;

    let puzzle: Puzzle;
    let found = new Set<string>();
    let foundColorIndex = 0;
    let selecting = false;
    let startCell: Cell | null = null;
    let currentPath: Cell[] = [];
    /** Tap-tap mode: first letter waiting for second */
    let anchorCell: Cell | null = null;
    let startTime = Date.now();
    let timerId: number | undefined;
    let activePointerId: number | null = null;
    let dragMoved = false;
    let destroyed = false;
    let hintsLeft = 3;

    function pathToWord(path: Cell[]) {
      return path.map(p => puzzle.grid[p.r][p.c]).join("");
    }

    function clearClass(cls: string) {
      boardEl.querySelectorAll(`.${cls}`).forEach(el => el.classList.remove(cls));
    }

    function clearSelectionHighlight() {
      clearClass("ws-cell--select");
    }

    function clearAnchorHighlight() {
      clearClass("ws-cell--anchor");
    }

    function paintPath(path: Cell[], cls: string) {
      for (const p of path) {
        boardEl
          .querySelector(`[data-r="${p.r}"][data-c="${p.c}"]`)
          ?.classList.add(cls);
      }
    }

    function setHintMessage(msg: string) {
      hintMsg.textContent = msg;
    }

    function updateProgress() {
      const total = puzzle.words.length;
      const n = found.size;
      progressEl.textContent = `${n}/${total}`;
      progressBar.style.width = total ? `${(n / total) * 100}%` : "0%";
      if (n === total && total > 0) {
        const ms = Date.now() - startTime;
        statusEl.textContent = "";
        const timeLabel = formatTime(ms);
        winDetail.textContent = `All ${total} words in ${timeLabel}`;

        const packId =
          puzzle.pack || root.dataset.pack || "daily";
        const playKind =
          (root.dataset.playKind as "daily" | "practice") || "daily";
        const bankRaw = root.dataset.practiceBankId;
        const practiceBankId = bankRaw ? Number(bankRaw) : undefined;
        const hintsUsed = Math.max(0, 3 - hintsLeft);

        // Local streak only for calendar dailies (not practice bank)
        let store = null as ReturnType<typeof markPuzzleComplete> | null;
        if (playKind !== "practice" && puzzle.playDate) {
          store = markPuzzleComplete(packId, puzzle.playDate, ms);
        }
        if (winStreak) {
          if (
            playKind !== "practice" &&
            packId === "daily" &&
            store &&
            store.streak > 0
          ) {
            winStreak.hidden = false;
            winStreak.textContent =
              store.streak === 1
                ? "First clear today · streak started"
                : `${store.streak}-day streak · best ${store.bestStreak}`;
          } else {
            winStreak.hidden = true;
          }
        }
        // expose for share
        (winEl as HTMLElement & { __share?: string }).__share =
          formatShareText({
            title: puzzle.title || "Daily Word Hunt",
            date: puzzle.playDate,
            timeLabel,
            streak:
              playKind !== "practice" && packId === "daily" && store
                ? store.streak
                : 0,
            url: location.origin + location.pathname,
          });

        winEl.hidden = false;
        if (timerId) window.clearInterval(timerId);
        document.dispatchEvent(
          new CustomEvent("dwh:puzzle-complete", {
            detail: {
              packId,
              playDate: puzzle.playDate,
              timeMs: ms,
              store,
              playKind,
              practiceBankId,
              hintsUsed,
              success: true,
            },
          })
        );
      }
    }

    function showGloss(word: string, gloss: string) {
      glossBox.hidden = false;
      glossWord.textContent = word;
      glossText.textContent = gloss || "—";
    }

    function flashMiss() {
      boardEl.classList.add("ws-board--miss");
      window.setTimeout(() => boardEl.classList.remove("ws-board--miss"), 180);
    }

    function markFound(path: Cell[], match: PuzzleWord) {
      const color = foundColorIndex % FOUND_COLORS;
      foundColorIndex++;
      found.add(match.word);
      for (const p of path) {
        const el = boardEl.querySelector(
          `[data-r="${p.r}"][data-c="${p.c}"]`
        ) as HTMLElement | null;
        if (!el) continue;
        el.classList.add("ws-cell--found", `ws-cell--found-${color}`);
      }
      const chip = wordlistEl.querySelector(
        `[data-word="${match.word}"]`
      ) as HTMLElement | null;
      chip?.classList.add("ws-chip--found", `ws-chip--found-${color}`);
      showGloss(match.word, match.gloss);
      updateProgress();
    }

    function tryComplete(path: Cell[]): boolean {
      if (path.length < 2) {
        clearSelectionHighlight();
        return false;
      }
      const forward = pathToWord(path);
      const reverse = pathToWord([...path].reverse());
      const match = puzzle.words.find(
        w => !found.has(w.word) && (w.word === forward || w.word === reverse)
      );
      if (!match) {
        clearSelectionHighlight();
        flashMiss();
        return false;
      }
      clearSelectionHighlight();
      clearAnchorHighlight();
      anchorCell = null;
      markFound(path, match);
      setHintMessage("");
      return true;
    }

    function cellFromPoint(x: number, y: number): Cell | null {
      const el = document.elementFromPoint(x, y)?.closest?.(".ws-cell") as
        | HTMLElement
        | null;
      if (!el || !boardEl.contains(el)) return null;
      return { r: Number(el.dataset.r), c: Number(el.dataset.c) };
    }

    function cellFromEventTarget(t: EventTarget | null): Cell | null {
      const el = (t as HTMLElement | null)?.closest?.(".ws-cell") as
        | HTMLElement
        | null;
      if (!el || !boardEl.contains(el)) return null;
      return { r: Number(el.dataset.r), c: Number(el.dataset.c) };
    }

    function setAnchor(cell: Cell) {
      clearAnchorHighlight();
      clearSelectionHighlight();
      anchorCell = cell;
      paintPath([cell], "ws-cell--anchor");
      setHintMessage("Now tap the last letter of the word.");
    }

    function clearAnchorMode() {
      anchorCell = null;
      clearAnchorHighlight();
      clearSelectionHighlight();
      setHintMessage("");
    }

    /** Tap-tap: second tap completes a straight line */
    function handleTap(cell: Cell) {
      if (!anchorCell) {
        setAnchor(cell);
        return;
      }
      if (cellsEqual(anchorCell, cell)) {
        clearAnchorMode();
        return;
      }
      const path = lineBetween(anchorCell, cell);
      if (!path || path.length < 2) {
        // Invalid line — treat as new anchor
        setAnchor(cell);
        return;
      }
      clearAnchorHighlight();
      paintPath(path, "ws-cell--select");
      const ok = tryComplete(path);
      if (!ok) {
        // Failed match — start new anchor on this cell
        setAnchor(cell);
      }
    }

    function onStart(e: PointerEvent) {
      const cell = cellFromEventTarget(e.target);
      if (!cell) return;
      e.preventDefault();
      selecting = true;
      dragMoved = false;
      activePointerId = e.pointerId;
      startCell = cell;
      currentPath = [cell];
      // If we were in tap-tap mode, keep anchor until we know it's a drag
      clearSelectionHighlight();
      paintPath(currentPath, "ws-cell--select");
      try {
        boardEl.setPointerCapture(e.pointerId);
      } catch {
        /* ignore */
      }
    }

    function onMove(e: PointerEvent) {
      if (!selecting || !startCell) return;
      if (activePointerId !== null && e.pointerId !== activePointerId) return;
      e.preventDefault();
      const cell =
        cellFromPoint(e.clientX, e.clientY) ?? cellFromEventTarget(e.target);
      if (!cell) return;
      const path = lineBetween(startCell, cell);
      if (!path) return;
      if (path.length > 1) {
        dragMoved = true;
        // Drag cancels pending tap-tap anchor from a previous gesture
        if (anchorCell) {
          clearAnchorHighlight();
          anchorCell = null;
          setHintMessage("");
        }
      }
      currentPath = path;
      clearSelectionHighlight();
      paintPath(path, "ws-cell--select");
    }

    function onEnd(e: PointerEvent) {
      if (!selecting) return;
      if (activePointerId !== null && e.pointerId !== activePointerId) return;
      selecting = false;
      activePointerId = null;
      try {
        if (boardEl.hasPointerCapture?.(e.pointerId)) {
          boardEl.releasePointerCapture(e.pointerId);
        }
      } catch {
        /* ignore */
      }

      if (dragMoved && currentPath.length >= 2) {
        // Drag complete
        tryComplete(currentPath);
      } else if (startCell && !dragMoved) {
        // Pure tap → two-tap mode
        clearSelectionHighlight();
        handleTap(startCell);
      } else {
        clearSelectionHighlight();
      }

      startCell = null;
      currentPath = [];
      dragMoved = false;
    }

    function renderBoard() {
      boardEl.style.setProperty("--ws-cols", String(puzzle.cols));
      boardEl.innerHTML = "";
      for (let r = 0; r < puzzle.rows; r++) {
        for (let c = 0; c < puzzle.cols; c++) {
          const cell = document.createElement("div");
          cell.className = "ws-cell";
          cell.dataset.r = String(r);
          cell.dataset.c = String(c);
          cell.textContent = puzzle.grid[r][c];
          cell.setAttribute("role", "gridcell");
          cell.setAttribute(
            "aria-label",
            `Row ${r + 1} column ${c + 1}, ${puzzle.grid[r][c]}`
          );
          boardEl.appendChild(cell);
        }
      }
    }

    function renderWordlist() {
      wordlistEl.innerHTML = "";
      for (const w of puzzle.words) {
        const li = document.createElement("li");
        li.dataset.word = w.word;
        li.className = "ws-chip";
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "ws-chip-btn";
        btn.textContent = w.word;
        btn.addEventListener("click", () => {
          if (found.has(w.word)) showGloss(w.word, w.gloss);
        });
        li.appendChild(btn);
        wordlistEl.appendChild(li);
      }
    }

    function useHint() {
      if (hintsLeft <= 0) {
        setHintMessage("No hints left.");
        return;
      }
      const remaining = puzzle.words.filter(w => !found.has(w.word));
      if (!remaining.length) return;
      const target = remaining[Math.floor(Math.random() * remaining.length)];
      // Prefer path from generator if present; else flash chip only
      const path = target.path;
      if (!path || path.length < 2) {
        const chip = wordlistEl.querySelector(`[data-word="${target.word}"]`);
        chip?.classList.add("ws-chip--hint");
        window.setTimeout(() => chip?.classList.remove("ws-chip--hint"), 1200);
        setHintMessage(`Look for: ${target.word} (${--hintsLeft} hints left)`);
        hintBtn.textContent = `Hint (${hintsLeft})`;
        return;
      }
      hintsLeft--;
      hintBtn.textContent = `Hint (${hintsLeft})`;
      paintPath(path, "ws-cell--hint");
      window.setTimeout(() => {
        clearClass("ws-cell--hint");
      }, 1400);
      setHintMessage(
        `Hint: ${target.word} flashes on the board (${hintsLeft} left)`
      );
    }

    function tick() {
      if (!destroyed) timerEl.textContent = formatTime(Date.now() - startTime);
    }

    const onLarge = () => {
      root.classList.toggle("ws--large", largeToggle.checked);
    };
    const onWinDismiss = () => {
      winEl.hidden = true;
    };
    const onWinShare = async () => {
      const text =
        (winEl as HTMLElement & { __share?: string }).__share ||
        `I finished a Daily Word Hunt puzzle ${location.href}`;
      try {
        if (navigator.share) {
          await navigator.share({ text, url: location.href, title: "Daily Word Hunt" });
          return;
        }
      } catch {
        /* user cancelled or unsupported */
      }
      try {
        await navigator.clipboard.writeText(text);
        if (winShare) {
          const prev = winShare.textContent;
          winShare.textContent = "Copied!";
          window.setTimeout(() => {
            winShare.textContent = prev;
          }, 1200);
        }
      } catch {
        window.prompt("Copy share text:", text);
      }
    };
    const onHint = () => useHint();

    function formatDateInTz(date: Date, timeZone: string) {
      return new Intl.DateTimeFormat("en-CA", {
        timeZone,
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).format(date);
    }

    async function fetchPuzzle(url: string): Promise<Puzzle> {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`Failed to load puzzle: ${url}`);
      return (await res.json()) as Puzzle;
    }

    async function loadPuzzlePayload(): Promise<Puzzle> {
      const inline = root.dataset.puzzle;
      if (inline) return JSON.parse(inline) as Puzzle;

      // Calendar series: /puzzles/{pack}/{YYYY-MM-DD}.json in site TZ
      if (root.dataset.daily === "1") {
        const tz = root.dataset.tz || "America/New_York";
        const pack = root.dataset.pack || "daily";
        const today = formatDateInTz(new Date(), tz);
        const primary = `/puzzles/${pack}/${today}.json`;
        const fallback = root.dataset.fallback || "/puzzles/sample.json";
        try {
          return await fetchPuzzle(primary);
        } catch {
          console.warn(`No puzzle for ${pack}/${today}, using fallback`);
          return await fetchPuzzle(fallback);
        }
      }

      const url = root.dataset.puzzleUrl || "/puzzles/sample.json";
      return fetchPuzzle(url);
    }

    async function boot() {
      puzzle = await loadPuzzlePayload();
      if (destroyed) return;

      if (root.dataset.compact === "1") {
        // Play-first home: no long title; keep a short accessible name
        titleEl.textContent = "Today";
      } else {
        const dateLabel = puzzle.playDate ? ` · ${puzzle.playDate}` : "";
        titleEl.textContent = `${puzzle.title}${dateLabel}`;
      }
      renderBoard();
      renderWordlist();
      updateProgress();
      hintBtn.textContent = `Hint (${hintsLeft})`;
      startTime = Date.now();
      timerId = window.setInterval(tick, 250);
      tick();

      boardEl.addEventListener("pointerdown", onStart);
      document.addEventListener("pointermove", onDocMove, { passive: false });
      document.addEventListener("pointerup", onDocUp);
      document.addEventListener("pointercancel", onDocUp);
      largeToggle?.addEventListener("change", onLarge);
      winDismiss?.addEventListener("click", onWinDismiss);
      winShare?.addEventListener("click", onWinShare);
      hintBtn?.addEventListener("click", onHint);

      // Streak chip on page (optional)
      const streakChip = document.querySelector<HTMLElement>("[data-dwh-streak]");
      if (streakChip) {
        const st = readProgress();
        if (st.streak > 0) {
          streakChip.hidden = false;
          streakChip.textContent =
            st.streak === 1 ? "1-day streak" : `${st.streak}-day streak`;
        }
      }
    }

    function onDocMove(e: PointerEvent) {
      if (!selecting) return;
      onMove(e);
    }
    function onDocUp(e: PointerEvent) {
      if (!selecting) return;
      onEnd(e);
    }

    boot().catch(err => {
      if (destroyed) return;
      titleEl.textContent = "Could not load puzzle";
      statusEl.textContent = String(err);
      console.error(err);
    });

    return {
      destroy() {
        destroyed = true;
        if (timerId) window.clearInterval(timerId);
        boardEl.removeEventListener("pointerdown", onStart);
        document.removeEventListener("pointermove", onDocMove);
        document.removeEventListener("pointerup", onDocUp);
        document.removeEventListener("pointercancel", onDocUp);
        largeToggle?.removeEventListener("change", onLarge);
        winDismiss?.removeEventListener("click", onWinDismiss);
        winShare?.removeEventListener("click", onWinShare);
        hintBtn?.removeEventListener("click", onHint);
      },
    };
  }

  const instances = new WeakMap<HTMLElement, GameCtl>();

  function initAll() {
    document.querySelectorAll<HTMLElement>("[data-ws-root]").forEach(root => {
      instances.get(root)?.destroy();
      instances.set(root, mountGame(root));
    });
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>

