---
/**
 * Printable worksheet: static grid + word list (not the interactive player).
 * Loads today’s (or ?date=) puzzle client-side for correct site timezone,
 * with optional SSR seed so first paint isn’t empty when build date matches.
 */
import type { Puzzle } from "@/lib/puzzle/types";

type Props = {
  packId?: string;
  timezone?: string;
  /** YYYY-MM-DD override (e.g. from ?date=) */
  playDate?: string;
  fallbackUrl?: string;
  /** Optional preloaded puzzle for SSR first paint */
  seed?: Puzzle | null;
  playHref?: string;
};

const {
  packId = "daily",
  timezone = "America/New_York",
  playDate = "",
  fallbackUrl = "/puzzles/sample.json",
  seed = null,
  playHref = "/",
} = Astro.props;

const seedJson = seed ? JSON.stringify(seed) : "";
const seedTitle = seed?.title ?? "Daily Word Hunt";
const seedDate = seed?.playDate ?? (playDate || "…");
const seedWords = seed?.words?.map(w => w.word) ?? [];
const seedGrid = seed?.grid ?? [];
---

<div
  class="pw"
  data-pw-root
  data-pack={packId}
  data-tz={timezone}
  data-date={playDate || undefined}
  data-fallback={fallbackUrl}
  data-seed={seedJson || undefined}
>
  <div class="pw-toolbar no-print">
    <div class="pw-toolbar-copy">
      <h1 class="pw-toolbar-title">Printable word search</h1>
      <p class="pw-toolbar-desc">
        Clean worksheet layout for paper. Click <strong>Print</strong> or use
        <kbd>Cmd</kbd>/<kbd>Ctrl</kbd>+<kbd>P</kbd>.
        <a class="pw-inline-link" href={playHref}>Play on screen instead</a>
      </p>
    </div>
    <div class="pw-toolbar-actions">
      <button type="button" class="pw-btn pw-btn--primary" data-pw-print disabled>
        Print
      </button>
      <a class="pw-btn pw-btn--ghost" href={playHref}>Play today</a>
    </div>
  </div>

  <p class="pw-status no-print" data-pw-status aria-live="polite">
    {seed ? "Worksheet ready." : "Loading puzzle…"}
  </p>

  <article class="pw-sheet" data-pw-sheet aria-label="Printable puzzle worksheet">
    <header class="pw-sheet-head">
      <p class="pw-brand">Daily Word Hunt</p>
      <h2 class="pw-sheet-title" data-pw-title>{seedTitle}</h2>
      <p class="pw-sheet-meta">
        <span data-pw-date>{seedDate}</span>
        <span class="pw-meta-sep" aria-hidden="true">·</span>
        <span data-pw-size
          >{seedGrid.length
            ? `${seedGrid.length}×${seedGrid[0]?.length ?? 0}`
            : "—"}</span
        >
        <span class="pw-meta-sep" aria-hidden="true">·</span>
        <span>Free printable · words.sagasu.art</span>
      </p>
      <p class="pw-instructions">
        Find each word in the grid. Words run horizontally, vertically, or
        diagonally — forwards or backwards. Circle or highlight as you go.
      </p>
    </header>

    <div class="pw-body">
      <div class="pw-grid-wrap">
        <table class="pw-grid" data-pw-grid role="grid" aria-label="Letter grid">
          {
            seedGrid.length > 0 ? (
              <tbody>
                {seedGrid.map(row => (
                  <tr>
                    {row.map(letter => (
                      <td>{letter}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ) : (
              <tbody data-pw-grid-placeholder>
                <tr>
                  <td class="pw-grid-empty" colspan="10">
                    Loading grid…
                  </td>
                </tr>
              </tbody>
            )
          }
        </table>
      </div>

      <section class="pw-words" aria-labelledby="pw-words-heading">
        <h3 id="pw-words-heading" class="pw-words-title">
          Word list
          <span class="pw-words-count" data-pw-count
            >{seedWords.length ? `(${seedWords.length})` : ""}</span
          >
        </h3>
        <ul class="pw-word-list" data-pw-words>
          {
            seedWords.map(w => (
              <li>{w.toUpperCase()}</li>
            ))
          }
        </ul>
      </section>
    </div>

    <footer class="pw-sheet-foot">
      <span>© Daily Word Hunt · Non-commercial classroom use OK</span>
      <span data-pw-id>{seed?.id ?? ""}</span>
    </footer>
  </article>
</div>

<script>
  type PuzzleWord = { word: string; gloss?: string };
  type Puzzle = {
    id?: string;
    playDate?: string;
    pack?: string;
    title?: string;
    rows?: number;
    cols?: number;
    grid: string[][];
    words: PuzzleWord[];
  };

  function formatDateInTimeZone(date: Date, timeZone: string): string {
    return new Intl.DateTimeFormat("en-CA", {
      timeZone,
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(date);
  }

  function qs<T extends HTMLElement>(root: ParentNode, sel: string) {
    return root.querySelector<T>(sel);
  }

  function paint(root: HTMLElement, puzzle: Puzzle) {
    const title = qs(root, "[data-pw-title]");
    const dateEl = qs(root, "[data-pw-date]");
    const sizeEl = qs(root, "[data-pw-size]");
    const countEl = qs(root, "[data-pw-count]");
    const idEl = qs(root, "[data-pw-id]");
    const gridEl = qs<HTMLTableElement>(root, "[data-pw-grid]");
    const wordsEl = qs(root, "[data-pw-words]");
    const status = qs(root, "[data-pw-status]");
    const printBtn = qs<HTMLButtonElement>(root, "[data-pw-print]");

    if (title) title.textContent = puzzle.title || "Daily Word Hunt";
    if (dateEl) dateEl.textContent = puzzle.playDate || "—";
    if (sizeEl) {
      const r = puzzle.grid?.length ?? puzzle.rows ?? 0;
      const c = puzzle.grid?.[0]?.length ?? puzzle.cols ?? 0;
      sizeEl.textContent = r && c ? `${r}×${c}` : "—";
    }
    if (idEl) idEl.textContent = puzzle.id || "";

    if (gridEl && Array.isArray(puzzle.grid)) {
      const tb = document.createElement("tbody");
      for (const row of puzzle.grid) {
        const tr = document.createElement("tr");
        for (const letter of row) {
          const td = document.createElement("td");
          td.textContent = String(letter).toUpperCase();
          tr.appendChild(td);
        }
        tb.appendChild(tr);
      }
      gridEl.replaceChildren(tb);
    }

    if (wordsEl && Array.isArray(puzzle.words)) {
      wordsEl.replaceChildren();
      for (const w of puzzle.words) {
        const li = document.createElement("li");
        li.textContent = String(w.word || "").toUpperCase();
        wordsEl.appendChild(li);
      }
      if (countEl) countEl.textContent = `(${puzzle.words.length})`;
    }

    if (status) status.textContent = "Worksheet ready — print when you like.";
    if (printBtn) printBtn.disabled = false;
    root.dataset.ready = "1";
  }

  async function loadPuzzle(root: HTMLElement): Promise<Puzzle> {
    const pack = root.dataset.pack || "daily";
    const tz = root.dataset.tz || "America/New_York";
    const forced = root.dataset.date?.trim();
    const fallback = root.dataset.fallback || "/puzzles/sample.json";
    const date = forced || formatDateInTimeZone(new Date(), tz);
    const url = `/puzzles/${pack}/${date}.json`;

    try {
      const res = await fetch(url);
      if (res.ok) return (await res.json()) as Puzzle;
    } catch {
      /* fall through */
    }

    // Prefer seed if it matches requested date
    if (root.dataset.seed) {
      try {
        const seeded = JSON.parse(root.dataset.seed) as Puzzle;
        if (!forced || seeded.playDate === date) return seeded;
      } catch {
        /* ignore */
      }
    }

    const fb = await fetch(fallback);
    if (!fb.ok) throw new Error("Puzzle unavailable");
    return (await fb.json()) as Puzzle;
  }

  async function initRoot(root: HTMLElement) {
    const printBtn = qs<HTMLButtonElement>(root, "[data-pw-print]");
    const status = qs(root, "[data-pw-status]");

    printBtn?.addEventListener("click", () => {
      if (root.dataset.ready !== "1") return;
      window.print();
    });

    // Seeded SSR content is already printable; still refresh for user TZ
    if (root.dataset.seed && !root.dataset.date) {
      try {
        const seeded = JSON.parse(root.dataset.seed) as Puzzle;
        paint(root, seeded);
      } catch {
        /* load below */
      }
    }

    try {
      const puzzle = await loadPuzzle(root);
      paint(root, puzzle);
    } catch {
      if (status) {
        status.textContent =
          "Could not load today’s puzzle. Try again or play on screen.";
      }
      if (printBtn) printBtn.disabled = true;
    }
  }

  function boot() {
    document
      .querySelectorAll<HTMLElement>("[data-pw-root]")
      .forEach(root => {
        void initRoot(root);
      });
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>

<style is:global>
  .pw {
    --pw-ink: #111;
    --pw-muted: #444;
    --pw-line: #222;
    --pw-paper: #fff;
    --pw-screen-bg: var(--background, #fafafa);
    --pw-accent: var(--accent, #0b57d0);
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }

  .pw-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 0.75rem;
  }

  .pw-toolbar-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--foreground, #111);
  }

  .pw-toolbar-desc {
    margin: 0.35rem 0 0;
    max-width: 28rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted-foreground, #555);
  }

  .pw-toolbar-desc kbd {
    font-size: 0.75rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--border, #ccc);
    border-radius: 0.25rem;
  }

  .pw-inline-link {
    color: var(--pw-accent);
    font-weight: 600;
    text-underline-offset: 2px;
  }

  .pw-toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pw-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.45rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    font-family: inherit;
  }

  .pw-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .pw-btn--primary {
    background: var(--pw-accent);
    color: #fff;
  }

  .pw-btn--primary:not(:disabled):hover {
    filter: brightness(1.05);
  }

  .pw-btn--ghost {
    background: transparent;
    color: var(--foreground, #111);
    border-color: var(--border, #ccc);
  }

  .pw-status {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted-foreground, #666);
  }

  /* —— Worksheet (screen preview + paper) —— */
  .pw-sheet {
    background: var(--pw-paper);
    color: var(--pw-ink);
    border: 1px solid var(--border, #ddd);
    border-radius: 0.65rem;
    padding: 1.25rem 1.1rem 1rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 4%);
  }

  .pw-sheet-head {
    text-align: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--pw-line);
  }

  .pw-brand {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pw-muted);
  }

  .pw-sheet-title {
    margin: 0.25rem 0 0;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--pw-ink);
  }

  .pw-sheet-meta {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    color: var(--pw-muted);
  }

  .pw-meta-sep {
    margin: 0 0.35rem;
  }

  .pw-instructions {
    margin: 0.65rem auto 0;
    max-width: 28rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--pw-muted);
  }

  .pw-body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .pw-grid-wrap {
    display: flex;
    justify-content: center;
  }

  .pw-grid {
    border-collapse: collapse;
    table-layout: fixed;
    font-family:
      ui-monospace,
      "SF Mono",
      Menlo,
      Consolas,
      monospace;
    font-size: 1.05rem;
    line-height: 1;
    user-select: none;
  }

  .pw-grid td {
    width: 1.75rem;
    height: 1.75rem;
    text-align: center;
    vertical-align: middle;
    border: 1.5px solid var(--pw-line);
    font-weight: 600;
    color: var(--pw-ink);
    background: #fff;
  }

  .pw-grid-empty {
    width: auto !important;
    height: auto !important;
    padding: 1.5rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--pw-muted);
    border: 1px dashed #bbb !important;
  }

  .pw-words-title {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--pw-ink);
    border-bottom: 1px solid #ccc;
    padding-bottom: 0.3rem;
  }

  .pw-words-count {
    font-weight: 600;
    color: var(--pw-muted);
  }

  .pw-word-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--pw-ink);
  }

  .pw-word-list li {
    padding: 0.15rem 0;
    border-bottom: 1px dotted #ccc;
  }

  .pw-sheet-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem;
    margin-top: 1.1rem;
    padding-top: 0.55rem;
    border-top: 1px solid #ccc;
    font-size: 0.65rem;
    color: var(--pw-muted);
  }

  @media (min-width: 480px) {
    .pw-word-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .pw-grid {
      font-size: 1.15rem;
    }
    .pw-grid td {
      width: 1.95rem;
      height: 1.95rem;
    }
  }

  /* —— Print / paper —— */
  @media print {
    @page {
      margin: 12mm;
      size: auto;
    }

    html,
    body {
      background: #fff !important;
      color: #000 !important;
    }

    header.app-layout,
    footer.app-layout,
    footer,
    .no-print,
    #skip-to-content,
    .cc,
    [data-cookie-consent] {
      display: none !important;
    }

    .pw {
      max-width: none;
    }

    .pw-sheet {
      border: none !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      padding: 0 !important;
      background: #fff !important;
      color: #000 !important;
    }

    .pw-sheet-head {
      border-bottom-color: #000 !important;
    }

    .pw-brand,
    .pw-sheet-meta,
    .pw-instructions,
    .pw-sheet-foot,
    .pw-words-count {
      color: #333 !important;
    }

    .pw-sheet-title,
    .pw-words-title,
    .pw-word-list,
    .pw-grid td {
      color: #000 !important;
    }

    .pw-grid td {
      border-color: #000 !important;
      background: #fff !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .pw-body {
      gap: 8mm;
    }

    /* Prefer grid + words on one page for ~10×10 */
    .pw-grid {
      font-size: 12pt;
    }
    .pw-grid td {
      width: 7.5mm;
      height: 7.5mm;
    }

    .pw-word-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      font-size: 10.5pt;
      gap: 1.5mm 4mm;
    }

    .pw-word-list li {
      border-bottom-color: #999 !important;
    }
  }
</style>
