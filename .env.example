# Copy to .env for local dev (never commit .env)
# Cloudflare Pages: Project → Settings → Environment variables → Production

# Google Analytics 4 — baked into <head> with Consent Mode (default denied).
# Must be set at Cloudflare Pages *build* time for installer detection.
PUBLIC_GA_MEASUREMENT_ID=G-SZMGNMBD0Z

# Optional Plausible (cookieless aggregate stats)
# PUBLIC_PLAUSIBLE_DOMAIN=words.sagasu.art

# Optional Search Console verification
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Cloudflare Pages Functions (Production + Preview) ---
# Google OAuth (Web application client). Authorized redirect URI:
#   https://words.sagasu.art/api/auth/callback
#   http://localhost:8788/api/auth/callback  (wrangler pages dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Canonical origin for OAuth redirect (no trailing slash)
SITE_URL=https://words.sagasu.art
# Optional extra secret for cookies (defaults to client secret if unset)
# AUTH_SECRET=
